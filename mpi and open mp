#include <omp.h>
#include <iostream>

int main() {
    omp_set_num_threads(4);  // Set number of threads to 4

    #pragma omp parallel
    {
        int thread_id = omp_get_thread_num();       // Get thread ID
        int total_threads = omp_get_num_threads();  // Get total number of threads

        std::cout << "Hello World from thread " << thread_id
                  << " out of " << total_threads << " threads.\n";
    }

    return 0;
}



